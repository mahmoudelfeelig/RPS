MONGO_URI=mongodb://127.0.0.1:27017/rps
PORT=5000
NODE_ENV=development
JWT_SECRET=your_jwt_key
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://rps.elfeel.me

# Brevo SMTP for verification and transactional mail
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_login
SMTP_PASS=your_rps_smtp_key
EMAIL_FROM="RPS <rps@notify.elfeel.me>"
EMAIL_VERIFY_BASE_URL=https://rps.elfeel.me/verify-email
PASSWORD_RESET_BASE_URL=https://rps.elfeel.me/reset-password

# Optional real-market data for game-currency investments
ALPHA_VANTAGE_API_KEY=
MARKET_STOCK_LIMIT=1000
MARKET_CRYPTO_LIMIT=100
MARKET_QUOTE_BATCH_SIZE=8
MARKET_UNIVERSE_CACHE_MS=86400000
MARKET_PRUNE_ASSETS=false

# Economy simulation
ECONOMY_BOTS_ENABLED=true
BOT_SIMULATION_ENABLED=true
BOT_SIMULATION_CRON=*/5 * * * *

# Optional if you keep uploads on the server disk behind the API
UPLOAD_STORAGE_DIR=/var/lib/rps/uploads
