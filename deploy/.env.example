NODE_ENV=production
PORT=5000
MONGO_URI=mongodb+srv://user:password@cluster.example.mongodb.net/rps?retryWrites=true&w=majority
JWT_SECRET=change-me
FRONTEND_URL=https://rps.elfeel.me
CORS_ORIGINS=https://rps.elfeel.me

# Brevo SMTP for verification and transactional mail
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_login
SMTP_PASS=your_rps_smtp_key
EMAIL_FROM="RPS <rps@notify.elfeel.me>"
EMAIL_VERIFY_BASE_URL=https://rps.elfeel.me/verify-email

# Hetzner-backed uploads on the API server
UPLOAD_STORAGE_DIR=/data/uploads
